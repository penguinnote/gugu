{
  "name": "ninetynine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-kiwi-model.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "supabase db push --linked",
    "db:seed": "node scripts/db-seed.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "test:rls": "node --test tests/rls/*.test.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:rls && npm run test:ui",
    "roster:import": "node scripts/roster-import.mjs",
    "roster:check": "node scripts/roster-import.mjs --check",
    "roster:details": "node scripts/roster-details.mjs",
    "roster:details:check": "node scripts/roster-details.mjs --check",
    "demo:seed": "node scripts/demo-records.mjs seed",
    "demo:clear": "node scripts/demo-records.mjs clear",
    "verify": "node scripts/verify.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "eval:digest": "vitest run -c eval/digest/vitest.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "jszip": "^3.10.2",
    "kiwi-nlp": "0.24.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
