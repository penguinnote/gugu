# 구구(Ninetynine) 환경변수 예시
#
# 이 파일을 복사해서 .env.local 을 만들고 값을 채운다.
#   cp .env.example .env.local
#
# .env.local 은 .gitignore 에 걸려 있어 GitHub 에 올라가지 않는다.
# 이 파일(.env.example)에는 키 이름만 두고 값은 절대 적지 않는다.
# Vercel 에 배포할 때는 같은 이름으로 프로젝트 설정 화면에 등록한다.

# ---------------------------------------------------------------------------
# Supabase (공개 값 — 브라우저 번들에 포함된다)
# ---------------------------------------------------------------------------

# Supabase 대시보드 > Project Settings > Data API > Project URL
# 예: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 대시보드 > Project Settings > API Keys > publishable key
# 프로젝트가 예전 방식이면 'anon public' 키가 같은 자리에 있다. 둘 중 있는 것을 넣으면 된다.
# 공개돼도 되는 키다. 실제 권한 판단은 DB 의 RLS 정책이 한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 대시보드에서 켜둔 로그인 제공자. 쉼표로 구분한다.
# 코드는 카카오·구글을 모두 지원하지만, 여기 없는 제공자는 버튼이 '준비 중' 으로
# 비활성화된다. 켜지 않은 제공자로 시도하면 Supabase 가 오류를 돌려주는데
# 리더 눈에는 앱이 고장난 것으로 보이기 때문이다.
# 비워두면 구글만 켜진 것으로 본다.
#   NEXT_PUBLIC_AUTH_PROVIDERS=google
#   NEXT_PUBLIC_AUTH_PROVIDERS=google,kakao
NEXT_PUBLIC_AUTH_PROVIDERS=

# 배포본의 고정 도메인 (선택). 있으면 production 에서 리다이렉트·OAuth 콜백의 기준이 된다.
# 없으면 요청 헤더(x-forwarded-host / host)로 계산한다 — 개발 중에는 이 값을 비워둬야
# 폰(LAN IP)과 데스크톱(localhost)이 각자 제 주소로 돌아온다.
#   NEXT_PUBLIC_SITE_URL=https://ninetynine.example.com
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# 웹 푸시 (Step 7) — Vercel 의 Production 과 Preview 양쪽에 같은 값을 넣는다
# ---------------------------------------------------------------------------
# 없으면 알림만 건너뛴다(제출·스탬프는 그대로 된다). 내 정보의 '알림' 은 "준비되지 않았습니다" 로 보인다.

# VAPID 키 쌍. 한 번 만들고 바꾸지 않는다 — 바꾸면 모든 기기가 다시 알림을 켜야 한다.
#   npx web-push generate-vapid-keys
# 공개 키는 브라우저 번들에 들어간다(공개돼도 된다). 개인 키는 서버 전용.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서버(애플·구글)에 보내는 연락처. mailto: 주소나 앱 주소(https)를 쓴다.
VAPID_SUBJECT=mailto:admin@example.com

# 서버 전용 Supabase 키 — 남의 푸시 구독을 읽고 받는 사람 함수를 부른다(src/lib/supabase/admin.ts 만).
# Supabase 대시보드 > Project Settings > API Keys > secret key
# RLS 를 통째로 우회하므로 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SECRET_KEY=

# 월요일 미제출 알림 크론(/api/cron/reminder, vercel.json) 의 비밀. Vercel 이 Authorization 헤더로 보낸다.
#   openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI 주간 정리(목사님 홈의 'AI 정리') — 서버 전용. 기본은 꺼짐
# ---------------------------------------------------------------------------
# 셋이 모두 맞을 때만 만든다: DIGEST_AI_ENABLED=true · ANTHROPIC_API_KEY · Vercel Production.
# 미리보기는 운영 DB 를 쓰므로 Production 밖에서는 만들지 않는다. 키는 Vercel 의 Production 에만 넣는다.

# Claude Console(platform.claude.com) > API Keys. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# 평가(npm run eval:digest)도 이 키로 돈다 — 그때는 .env.local 이 아니라 명령 앞에 붙여 쓴다.
ANTHROPIC_API_KEY=

# true 일 때만 AI 정리를 만든다. 비우거나 다른 값이면 꺼짐(화면은 v1 칸만).
DIGEST_AI_ENABLED=

# 쓸 모델. claude-sonnet-5-5(기본) · claude-haiku-5-5 둘만 받는다. 비우거나 그 밖의 값이면 소넷.
#   소넷 5.5  100만 토큰당 입력 $2 · 출력 $10 — 글을 더 잘 읽는다
#   하이쿠 5.5 100만 토큰당 입력 $0.10 · 출력 $0.50 — 훨씬 싸고 빠르다
# 비교 평가: EVAL_MODELS=claude-sonnet-5-5,claude-haiku-5-5 npm run eval:digest
DIGEST_MODEL=

# 얼마나 깊이 생각할지. low · medium(기본) · high · xhigh · max. 두 모델 모두 다섯 단계를 지원한다.
# 높을수록 꼼꼼하지만 생각 토큰(출력으로 셈)이 늘어 비싸고 느리다. 그 밖의 값이면 medium.
DIGEST_EFFORT=

# ── 구구 AI(2026-11-12) — 사람별 흐름 요약 · 보고서 받아쓰기 · 구구 챗봇 ──
# 목사님 AI 정리와 따로 켜고 끈다. 셋이 모두 맞을 때만: GUGU_AI_ENABLED=true · ANTHROPIC_API_KEY(위와 같은 키) · Vercel Production.
# 켜면 리더 · 목사님에게 탭바 옆 구구 단추 · 전체 메뉴 '구구에게 물어보기' · 사람 화면 '최근 흐름' · 보고서 '모임 메모로 채우기' 가 보인다.
GUGU_AI_ENABLED=

# 쓸 모델. claude-sonnet-5-5(기본) · claude-haiku-5-5. 비우거나 그 밖의 값이면 소넷.
GUGU_AI_MODEL=
